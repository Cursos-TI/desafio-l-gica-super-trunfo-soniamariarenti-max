#include <stdio.h>
//Definição de constantes.
#define TAM 10 // Tamanho do tabuleiro (10x10).
#define AGUA 0 // Representa água.
#define NAVIO 3 // Representa parte de um navio.

int main(){
  int tabuleiro[TAM][TAM];  // Matriz que representa o tabuleiro.
  int i, j; // Variáveis auxiliares para percorrer linhas e colunas.
  
   //  1. Inicializar o tabuleiro com água.
    for(i = 0; i < TAM; i++){
        for(j = 0; j < TAM; j++){
          tabuleiro [i][j] = AGUA; // Preenche cada posição com 0 (água).
            
        }
    }
      int tamanho_navio = 3; // Tamanho fixo dos navios.
      
       // 2. Posicionar navio horizontal
    // Linha 2, colunas 1 a 3
      for( j = 1; j < 1 + tamanho_navio; j++){
          tabuleiro[2][j] = NAVIO;
          
      }
      //  3. Posicionar navio vertica
      // Coluna 6, linhas 5 a 7
      for(i = 5; i < 5 + tamanho_navio; i++){
          tabuleiro[i][6] = NAVIO;
      }
        //  4. Posicionar navio diagonal principa
       // Linha e coluna aumentam juntas: [0][0] a [2][2]
      for(i = 0; i < tamanho_navio; i++){
          tabuleiro[i][i] = NAVIO;
      }
      
    // 5. Posicionar navio diagonal secundária
    // Linha diminui e coluna aumenta: [9][7] a [7][9]
      for(i = 0; i < tamanho_navio; i++){
          tabuleiro[9 - i][7 + i] = NAVIO;
      }
      //  6. Exibir o tabuleiro completo 
      printf("=== TABULEIRO COMPLETO DE BATALHA NAVAL ===\n\n");
      
      for(i = 0; i < TAM; i++){
          for(j = 0; j < TAM; j++){
              printf("%d ", tabuleiro[i][j]);
          }
          printf("\n");
      }
    return 0;
}
 
